# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one provider: "ollama" | "gemini" | "openai" | "demo"
# Set to "demo" to use rule-based fallback (clearly labeled, no AI)
LLM_PROVIDER=demo

# ── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── App settings ──────────────────────────────────────────────────────────────
MAX_PDF_SIZE_MB=10
MAX_TEXT_LENGTH=15000
FRONTEND_ORIGIN=http://localhost:5173

# ── AI Image Generation (Cloudflare Workers AI — FLUX.1-schnell) ───────────────
# Provider: "cloudflare" (includes recurring daily free Neurons allowance)
IMAGE_PROVIDER=cloudflare
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Cloudflare Account ID:
# Find under Cloudflare Dashboard -> Workers & Pages -> Overview (right sidebar)
CLOUDFLARE_ACCOUNT_ID=your_account_id

# Cloudflare API Token:
# Create at https://dash.cloudflare.com/profile/api-tokens with "Workers AI" Read/Edit permissions
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
